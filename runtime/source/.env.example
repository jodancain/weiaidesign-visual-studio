VIDEO_API_BASE_URL=https://video.youngtuo.win/api/v1
VIDEO_WEB_PUBLIC_URL=https://video.youngtuo.win
VIDEO_API_TOKEN=replace-with-token-from-remote-env
VIDEO_STORAGE_BASE_URL=http://127.0.0.1:8788
VIDEO_STORAGE_TOKEN=replace-with-token-from-nas-env
IMAGE_VIDEO_BACKEND=gemini
IMAGE_OPENAI_MODEL=gpt-image-1.5
IMAGE_OPENAI_FALLBACK_MODELS=gpt-image-1
IMAGE_OPENAI_TIMEOUT_SECONDS=300
IMAGE_OPENAI_QUALITY=low
IMAGE_OPENAI_OUTPUT_FORMAT=jpeg
IMAGE_OPENAI_OUTPUT_COMPRESSION=70
IMAGE_OUTPUT_DIR=/MoneyPrinterTurbo/storage/generated_images
IMAGE_OPENAI_BASE_URL=https://video.youngtuo.win/relay/v1
VIDEO_API_PROXY_BASE_URL=https://video.youngtuo.win/api/v1
VIDEO_API_PROXY_TOKEN=replace-with-token-if-different-from-video-api-token
GEMINI_VIDEO_BASE_URL=https://video.youngtuo.win/relay/v1beta
GEMINI_VIDEO_API_KEY=replace-with-gemini-group-relay-token
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_SUBMIT_TIMEOUT_SECONDS=300
REMOTE_VIDEO_ARCHIVER_URL=http://127.0.0.1:18182/video-archive/drive
REMOTE_VIDEO_ARCHIVER_TOKEN=replace-with-internal-archive-token
REMOTE_VIDEO_ARCHIVER_FOLDER_ID=replace-with-drive-folder-id
REMOTE_VIDEO_ARCHIVER_PUBLIC=1
IMAGE_VIDEO_MAX_DURATION_SECONDS=60
IMAGE_VIDEO_SEGMENT_SECONDS=8
IMAGE_GENERATION_CONCURRENCY=1
IMAGE_GENERATION_RETRIES=3
VIDEO_SUBJECT=用30秒介绍云东AI视频服务

# ---- Video backend (gateway/node-gateway.mjs) ----
# seedance (default) | veo-openai | gemini. Only gemini honours a last frame.
VIDEO_BACKEND=seedance
# OpenAI-style video route; defaults to IMAGE_OPENAI_BASE_URL / IMAGE_OPENAI_API_KEY when unset.
OPENAI_VIDEO_BASE_URL=https://ezr.sh/v1
OPENAI_VIDEO_API_KEY=
SEEDANCE_MODEL=dreamina-seedance-2-0
# Seedance 2.x always renders audio and the relay drops generate_audio; on an
# OutputAudioSensitiveContentDetected rejection the job retries once on this model.
SEEDANCE_FALLBACK_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_AUDIO_HINT=No background music, no soundtrack, no singing; only quiet natural ambient sound.
VEO_OPENAI_MODEL=veo-3.1-fast-generate-001
# Optional keyframe image model that leads the fallback chain, e.g. seedream-4-5.
KEYFRAME_IMAGE_MODEL=
