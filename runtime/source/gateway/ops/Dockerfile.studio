# Repository-context wrapper for Studio evaluation: build context is gateway/.
# The runtime package matches ops/Dockerfile; only the credential-free config
# COPY path differs so the repository itself can be used as the build context.
FROM node:22-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-pil fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY node-gateway.mjs /node-gateway.mjs
COPY studio /studio
ENV STUDIO_DATA_DIR=/data/studio
VOLUME ["/data/studio"]
COPY ops/config.toml /config.toml
CMD ["node", "/node-gateway.mjs"]
