VIDEO_API_TOKEN=replace-with-video-api-token
PUBLIC_BASE_URL=https://replace-with-zeabur-domain/api/v1
NEXT_PUBLIC_SITE_URL=https://replace-with-zeabur-domain
NEXT_PUBLIC_API_BASE=https://replace-with-zeabur-domain/api/v1

# ezr.sh provides gpt-image-2, gpt-image-2.5-flare, gpt-image-2.5-sunburst, wan2.7-image-pro
# and correctly supports mask inpaint and background=transparent for gpt-image series
IMAGE_OPENAI_BASE_URL=https://ezr.sh/v1
IMAGE_OPENAI_API_KEY=replace-with-ezr-token
IMAGE_OPENAI_MODEL=gpt-image-2
IMAGE_OPENAI_FALLBACK_MODELS=gpt-image-1.5,gpt-image-2.5-flare,gpt-image-2.5-sunburst
IMAGE_OPENAI_TIMEOUT_SECONDS=300
IMAGE_OPENAI_QUALITY=low
IMAGE_OPENAI_OUTPUT_FORMAT=jpeg
IMAGE_OPENAI_OUTPUT_COMPRESSION=70
IMAGE_GENERATION_CONCURRENCY=1
IMAGE_GENERATION_RETRIES=3
# Production should point this at a persistent Zeabur volume/NAS mount.
# /tmp works for local smoke only and generated links can disappear after restart.
IMAGE_OUTPUT_DIR=/data/youngtuo-visual/generated_images

# Optional: proxy Image to video to the existing Windows/NAS gateway while the
# new Zeabur service owns only the web + GPT image generation surface.
VIDEO_API_PROXY_BASE_URL=https://video.youngtuo.win/api/v1
VIDEO_API_PROXY_TOKEN=replace-with-token-if-different-from-video-api-token

# Windows GPU ComfyUI (server-only; never expose as NEXT_PUBLIC_*).
# Fixed production entry: https://comfy.youngtuo.win (Mac byd tunnel → Windows :8189 → ComfyUI :8188)
GPU_COMFY_BASE_URL=https://comfy.youngtuo.win
GPU_COMFY_TOKEN=
GPU_COMFY_TIMEOUT_SECONDS=120
GPU_COMFY_POLL_INTERVAL_MS=1500
GPU_COMFY_POLL_ATTEMPTS=120

# Agent chat/design-plan LLM. Uses the same ezr.sh gateway (model names have no
# provider prefix here, unlike router.yundongyl.cn which used cx/ or cbcn/ prefixes).
AGENT_LLM_BASE_URL=https://ezr.sh/v1
AGENT_LLM_API_KEY=replace-with-ezr-token
AGENT_LLM_MODELS=claude-sonnet-5,gpt-5.5,kimi-k2.7-code

# TypeSafe Jev (System One): structured Choice/Noul decisions for the design-plan
# stage (pick image model, check Brand Kit compliance). Optional — silently skipped
# if unset. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=replace-with-typesafe-key
