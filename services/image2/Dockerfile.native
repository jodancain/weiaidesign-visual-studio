# Optional native-engine runtime; build the ordinary image2 service first.
# Native binaries are separately pinned, tested on Linux and mounted read-only.
ARG IMAGE2_BASE_IMAGE=weiai-image2:2.0.0
FROM ${IMAGE2_BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap=0.12.0-1~deb13u1 fontconfig fonts-noto-cjk libasound2t64 libfontconfig1 libfreetype6 \
    libudev1 libx11-6 libxcb1 libxkbcommon0 libwayland-client0 libegl1 libgl1 \
    libvulkan1 mesa-vulkan-drivers \
    curl ffmpeg poppler-utils python3 \
    && rm -rf /var/lib/apt/lists/*
USER node
# curl is the confinement test's independent network oracle; ffmpeg/ffprobe and
# Poppler verify real media/PDF output. No compilers, model weights or dev npm deps.
