{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "film": {
      "enum": [
        "three-knocks",
        "borrow-sunshine",
        "last-seed-of-light"
      ]
    },
    "fps": {
      "const": 24
    },
    "width": {
      "const": 1280
    },
    "height": {
      "const": 720
    },
    "totalFrames": {
      "const": 1440
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2
        },
        "keyIntensity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "fillIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "exposure",
        "keyIntensity",
        "fillIntensity"
      ]
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s(0[1-9]|10)$"
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1296
          },
          "endFrame": {
            "type": "integer",
            "minimum": 144,
            "maximum": 1440
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                },
                "minItems": 3,
                "maxItems": 3
              },
              "positionEnd": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                },
                "minItems": 3,
                "maxItems": 3
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                },
                "minItems": 3,
                "maxItems": 3
              },
              "targetEnd": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                },
                "minItems": 3,
                "maxItems": 3
              },
              "lensMm": {
                "type": "number",
                "minimum": 18,
                "maximum": 100
              }
            },
            "required": [
              "position",
              "positionEnd",
              "target",
              "targetEnd",
              "lensMm"
            ]
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "look-up",
                  "hear-knocks",
                  "knock-door",
                  "grasp-wheel",
                  "scout-approach",
                  "turn-wheel",
                  "scout-enter",
                  "inspect-thruster",
                  "plug-cell",
                  "answer-knocks",
                  "put-scissors",
                  "offer-umbrella",
                  "open-cloth-box",
                  "look-umbrella",
                  "cut-patch",
                  "give-umbrella",
                  "shop-alone",
                  "attach-sun",
                  "wave-thanks",
                  "light-shop",
                  "walk-lantern",
                  "hug-lantern",
                  "show-tree",
                  "hesitate",
                  "test-bridge",
                  "jump-bridge",
                  "hold-seed",
                  "drop-seed",
                  "grow-light",
                  "catch-new-seed"
                ]
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120
              },
              "endFrame": {
                "type": "integer",
                "minimum": 1,
                "maximum": 143
              },
              "beatFrames": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 143
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "kind",
              "startFrame",
              "endFrame"
            ]
          },
          "blocking": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "enum": [
                    "ashuan",
                    "scout",
                    "bear",
                    "mouse",
                    "fox"
                  ]
                },
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -30,
                    "maximum": 30
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "yaw": {
                  "type": "number",
                  "minimum": -6.283185307179586,
                  "maximum": 6.283185307179586
                }
              },
              "required": [
                "id",
                "position",
                "yaw"
              ]
            }
          }
        },
        "required": [
          "id",
          "startFrame",
          "endFrame",
          "camera",
          "action"
        ]
      },
      "minItems": 10,
      "maxItems": 10
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "film",
    "fps",
    "width",
    "height",
    "totalFrames",
    "seed",
    "shots"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio SceneProgram v1",
  "description": "Semantic validation additionally requires s01..s10 in order with contiguous 144-frame ranges, film-specific action sequence, endFrame>startFrame and increasing in-range beatFrames. Blocking actor ids must belong to film and be unique.",
  "x-film-actions": {
    "three-knocks": [
      "look-up",
      "hear-knocks",
      "knock-door",
      "grasp-wheel",
      "scout-approach",
      "turn-wheel",
      "scout-enter",
      "inspect-thruster",
      "plug-cell",
      "answer-knocks"
    ],
    "borrow-sunshine": [
      "put-scissors",
      "offer-umbrella",
      "open-cloth-box",
      "look-umbrella",
      "cut-patch",
      "give-umbrella",
      "shop-alone",
      "attach-sun",
      "wave-thanks",
      "light-shop"
    ],
    "last-seed-of-light": [
      "walk-lantern",
      "hug-lantern",
      "show-tree",
      "hesitate",
      "test-bridge",
      "jump-bridge",
      "hold-seed",
      "drop-seed",
      "grow-light",
      "catch-new-seed"
    ]
  }
}
