{
  "name": "weiaidesign-visual-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "image2:runtime": "node scripts/image2-runtime-assets.mjs",
    "predev": "npm run image2:runtime",
    "prebuild": "npm run image2:runtime",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:studio": "tsx --test tests/*.test.ts components/studio/director/*.test.ts",
    "test:studio:ui": "playwright test --config=playwright.studio.config.ts",
    "test:studio:loop": "playwright test --config=playwright.studio-loop.config.ts",
    "test:image2": "npm test --prefix services/image2",
    "test:image2:client": "tsx --test tests/image2-client.test.ts tests/image2-legacy-binding.test.ts tests/image2-templates.test.ts tests/image2-submissions.test.ts tests/image2-submissions-http.test.ts tests/image2-masks.test.ts tests/image2-legacy-drafts.test.ts tests/image2-legacy-mutations.test.ts tests/image2-bff-retry.test.ts tests/image2-professional-client.test.ts tests/image2-professional-migration.test.ts tests/image2-professional-properties.test.ts tests/image2-craft-client.test.ts tests/image2-chat-projection.test.ts tests/image2-browser-native-agent-fixture.test.mjs",
    "test:image2:browser": "playwright test --config=tests/image2-integration.config.ts",
    "test:image2:ui": "playwright test --config=tests/image2.playwright.config.ts",
    "test:image2:original-ui": "playwright test --config=tests/image2-legacy-browser.config.ts",
    "test:image2:original-recovery": "playwright test --config=tests/image2-legacy-recovery.config.ts",
    "test:image2:original-extended": "playwright test --config=tests/image2-legacy-extended.config.ts",
    "test:image2:context-menu": "playwright test --config=tests/image2-context-menu.config.ts",
    "test:image2:worker": "node --test tests/image2-render-worker.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/three": "4.0.532",
    "@xyflow/react": "12.12.0",
    "@xzdarcy/react-timeline-editor": "1.0.0",
    "canvaskit-wasm": "0.42.0",
    "css-tree": "3.1.0",
    "fast-xml-parser": "5.11.2",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.555.0",
    "next": "16.3.8",
    "openai": "^6.46.0",
    "pathkit-wasm": "1.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-virtualized": "9.22.6",
    "remotion": "4.0.532",
    "svg2pdf.js": "^2.7.0",
    "three": "0.186.0",
    "tldraw": "^3.15.6"
  },
  "overrides": {
    "postcss": "^8.5.17"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
